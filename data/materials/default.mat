#data/materials/default.mat
# ===================================================================
# RDE Default Material (schema-compliant)
# ===================================================================
version: 1.0
name: Default

dependencies:
  shaders:
    - "shaders/basic_lit.shaderdef"
  textures:
    - "textures/default_white.png"       # Index 0: Albedo
    - "textures/default_normal.png"      # Index 1: Normal
    - "textures/default_metal_rough.png" # Index 2: Metal/Rough/AO

# --- GPU Pipeline State ---
pipeline:
  cullMode: Back
  polygonMode: Fill
  depthTest: true
  depthWrite: true

# --- Material Parameters ---
parameters:
  - name: baseColor
    type: vec4
    value: [0.8, 0.8, 0.8, 1.0]
  - name: metalness
    type: float
    value: 0.0
  - name: roughness
    type: float
    value: 0.5
  - name: emissiveFactor
    type: vec3
    value: [0.0, 0.0, 0.0]

# --- Texture Maps ---
textures:
  - name: albedoMap
    index: 0
  - name: normalMap
    index: 1
  - name: metalRoughnessMap
    index: 2
